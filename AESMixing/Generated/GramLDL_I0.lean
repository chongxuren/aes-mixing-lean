def bound : ℚ := (1/10400)
def metric (a b : Fin 16) : ℚ := 256^AES.maskSize (maskIntersection a b)
def fixed (a b : Fin 16) : ℚ := 1 +
  (256^AES.maskSize a - 1) * (256^AES.maskSize b - 1) / (256^4-1)
theorem maskSize_table : ∀ a : Fin 16, AES.maskSize a =
    ![0,1,1,2,1,2,2,3,1,2,2,3,2,3,3,4] a := by decide
set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem weights_positive (k : Fin 16) : 0 < weights k := by
  fin_cases k <;> norm_num [weights]
set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem factorization (a b : Fin 16) :
    bound^2 * metric a b - (numerator a b : ℚ)/255^4 + fixed a b =
      ∑ k, weights k * rows k a * rows k b := by
  simp only [bound, metric, fixed]
  simp_rw [maskSize_intersection_table, maskSize_table]
  fin_cases a <;> fin_cases b <;>
    norm_num [numerator, weights, rows, Fin.sum_univ_succ, maskIntersection]
#print axioms weights_positive
#print axioms factorization
