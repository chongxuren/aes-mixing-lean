set_option maxRecDepth 65536 in
set_option maxHeartbeats 50000000 in
theorem mds_basis_certificate (r c : Fin 16) :
    maskSize r = maskSize c → ∀ (j : Fin 4) (b : Fin 8),
      columnMatrix (minorInverse r c)
        (projectMask r (columnMatrix mixEntry (projectMask c (injectByte j (byteBasis b))))) =
          projectMask c (injectByte j (byteBasis b)) := by
  fin_cases r <;> fin_cases c <;> decide

theorem mds_reconstruction (r c : Fin 16) (h : maskSize r = maskSize c)
    (x : Fin 4 → BinaryWord 8) :
    columnMatrix (minorInverse r c) (projectMask r (columnMatrix mixEntry (projectMask c x))) =
      projectMask c x :=
  masked_reconstruction_from_basis mixEntry (minorInverse r c) r c (mds_basis_certificate r c h) x

/-- Any equal number of free input bytes and prescribed output zeros force
zero input. This is the concrete AES MixColumns MDS zero-condition property. -/
theorem mixColumns_mds_zero (r c : Fin 16) (h : maskSize r = maskSize c)
    (x : Fin 4 → BinaryWord 8) (hs : projectMask c x = x)
    (hz : projectMask r (columnMatrix mixEntry x) = 0) : x = 0 :=
  masked_zero_from_reconstruction mixEntry (minorInverse r c) r c
    (mds_reconstruction r c h) x hs hz

