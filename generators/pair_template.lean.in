theorem caps (hcoeff : CoefficientSpec) :
    (∀ (r : Fin 4) (gamma : Byte), mixedSum q ordinaryMapHom (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) gamma (r.val+1) ≤ 111) ∧
    (∀ (r : Fin 2) (gamma : Byte), mixedSum h fourierMapHom (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) gamma (r.val+2) ≤ 7247757311) ∧
    (∀ (r : Fin 2), mixedSum h fourierMapHom (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 0 (AES8.PaperSharpEntriesInventoryAssembly.extremePower r) ≤ 7247757311) := by
  constructor
  · intro r gamma
    fin_cases r
    ·
      let stage0 : Vector := @@STAGE_00@@
      let stage1 : Vector := @@STAGE_01@@
      let stage2 : Vector := @@STAGE_02@@
      let stage3 : Vector := @@STAGE_03@@
      let stage4 : Vector := @@STAGE_04@@
      let stage5 : Vector := @@STAGE_05@@
      let stage6 : Vector := @@STAGE_06@@
      let stage7 : Vector := @@STAGE_07@@
      let stage8 : Vector := @@STAGE_08@@
      let stages : PaperSharpEntriesVectorChecker.VectorStages := fun s => match s.val with
        | 0 => stage0
        | 1 => stage1
        | 2 => stage2
        | 3 => stage3
        | 4 => stage4
        | 5 => stage5
        | 6 => stage6
        | 7 => stage7
        | _ => stage8
      have step0 : PaperSharpEntriesVectorChecker.checkStage stages 0 = true := by decide +kernel
      have step1 : PaperSharpEntriesVectorChecker.checkStage stages 1 = true := by decide +kernel
      have step2 : PaperSharpEntriesVectorChecker.checkStage stages 2 = true := by decide +kernel
      have step3 : PaperSharpEntriesVectorChecker.checkStage stages 3 = true := by decide +kernel
      have step4 : PaperSharpEntriesVectorChecker.checkStage stages 4 = true := by decide +kernel
      have step5 : PaperSharpEntriesVectorChecker.checkStage stages 5 = true := by decide +kernel
      have step6 : PaperSharpEntriesVectorChecker.checkStage stages 6 = true := by decide +kernel
      have step7 : PaperSharpEntriesVectorChecker.checkStage stages 7 = true := by decide +kernel
      have steps (s : Fin 8) : PaperSharpEntriesVectorChecker.checkStage stages s = true := by
        fin_cases s
        · exact step0
        · exact step1
        · exact step2
        · exact step3
        · exact step4
        · exact step5
        · exact step6
        · exact step7
      have initial : PaperSharpEntriesVectorChecker.checkInitial stages (ordinaryInitial (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 1) = true := by decide +kernel
      have caps : PaperSharpEntriesVectorChecker.checkCaps stages 111 = true := by decide +kernel
      have false_caps : PaperSharpEntriesVectorChecker.checkCaps stages 0 = false := by decide +kernel
      exact ordinary_cap hcoeff (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 1 (by omega) (by omega) stages initial steps caps gamma
    ·
