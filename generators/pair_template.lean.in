        · exact step1
        · exact step2
        · exact step3
        · exact step4
        · exact step5
        · exact step6
        · exact step7
      have initial : PaperSharpEntriesVectorChecker.checkInitial stages (ordinaryInitial (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 2) = true := by decide +kernel
      have caps : PaperSharpEntriesVectorChecker.checkCaps stages 111 = true := by decide +kernel
      have false_caps : PaperSharpEntriesVectorChecker.checkCaps stages 0 = false := by decide +kernel
      exact ordinary_cap hcoeff (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 2 (by omega) (by omega) stages initial steps caps gamma
    ·
      let stage0 : Vector := @@STAGE_18@@
