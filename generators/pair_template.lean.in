        have initial : PaperSharpEntriesVectorChecker.checkInitial stages (fourierInitial (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 2) = true := by decide +kernel
        have caps : PaperSharpEntriesVectorChecker.checkCaps stages 7247757311 = true := by decide +kernel
        have false_caps : PaperSharpEntriesVectorChecker.checkCaps stages 0 = false := by decide +kernel
