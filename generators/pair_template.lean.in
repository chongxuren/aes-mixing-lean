    · intro r
      fin_cases r
      · change mixedSum h fourierMapHom (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 0 1 ≤ 7247757311
        have direct : indexedSum hFast fourierFast (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 0 1 ≤ 7247757311 := by decide +kernel
        rw [mixedSum_eq_indexed]
        have hp : hFast = h := funext hFast_eq
        have hB : (fourierFast : Byte → Byte) = fourierMapHom := funext fourierFast_spec
        simpa only [hp, hB] using direct
      · change mixedSum h fourierMapHom (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 0 4 ≤ 7247757311
        have direct : indexedSum hFast fourierFast (byteOf (@@ALPHA@@ : Index)) (byteOf (@@BETA@@ : Index)) 0 4 ≤ 7247757311 := by decide +kernel
        rw [mixedSum_eq_indexed]
        have hp : hFast = h := funext hFast_eq
        have hB : (fourierFast : Byte → Byte) = fourierMapHom := funext fourierFast_spec
        simpa only [hp, hB] using direct
#print axioms caps
end AES8.@@NAME@@
