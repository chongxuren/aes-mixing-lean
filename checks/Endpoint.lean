example : AES8.PaperCurrentRecurrence.PhysicalEstimates :=
  AES8.PaperAESCompleteEstimates.profile_estimates

example (k : ℕ) :
    AESMixing.AES.epsilon (8+2*k) < 7 / (2 : ℝ)^(95+41*k) :=
  AES8.PaperAESFromCompleteEntries.epsilon_eight_plus_two k

example :
    AESMixing.AES.epsilon 10 < (1 : ℝ)/2^(133 : ℕ) ∧
    (1 : ℝ)/2^(133 : ℕ) < (1 : ℝ)/2^(128 : ℕ) ∧
    AESMixing.AES.epsilon 14 < (1 : ℝ)/2^(215 : ℕ) ∧
    (1 : ℝ)/2^(215 : ℕ) < (1 : ℝ)/2^(192 : ℕ) ∧
    AESMixing.AES.epsilon 16 < (1 : ℝ)/2^(256 : ℕ) :=
  AES8.PaperAESFromCompleteEntries.round_corollaries_exact

example {R O : Type*} [Fintype R] [Fintype O] [DecidableEq O]
    (weight : R → ℝ) (hw : ∀ t, 0 ≤ weight t) (hs : (∑ t, weight t) = 1)
    (program : R → AESPaper.TwoQueryProgram.Program AESMixing.AES.State O)
    (k : ℕ) :
    AESMixing.tv
      (AESPaper.TwoQueryProgram.realOutputLaw (AESMixing.AES.encrypt (8+2*k))
        (AESMixing.uniformKeyWeight (8+2*k+1)) weight program)
      (AESPaper.TwoQueryProgram.realOutputLaw
        (fun p : Equiv.Perm AESMixing.AES.State =>
          (p : AESMixing.AES.State → AESMixing.AES.State))
        AESPaper.UniformPermutation.permutationWeight weight program) <
      7 / (2 : ℝ)^(95+41*k) :=
  AES8.PaperAESFromCompleteEntries.adaptive_program_output_lt weight hw hs program k

