def q4Stages : StageTables := fun s => match s.val with
  | 0 => q4Stage0
  | 1 => q4Stage1
  | 2 => q4Stage2
  | 3 => q4Stage3
  | 4 => q4Stage4
  | 5 => q4Stage5
  | 6 => q4Stage6
  | 7 => q4Stage7
  | _ => q4Stage8

#eval (do IO.println "starting q4"; (← IO.getStdout).flush : IO Unit)
theorem q4_initial_bool : checkInitialBool q4Stages (fun i => powerProfile qFast 4 (byteOf i)) = true := by decide +kernel
theorem q4_initial : checkInitial q4Stages (fun i => powerProfile qFast 4 (byteOf i)) = true := checkInitialBool_sound _ _ q4_initial_bool
theorem q4_step0 : checkStage q4Stages 0 = true := by decide +kernel
theorem q4_step1 : checkStage q4Stages 1 = true := by decide +kernel
theorem q4_step2 : checkStage q4Stages 2 = true := by decide +kernel
theorem q4_step3 : checkStage q4Stages 3 = true := by decide +kernel
theorem q4_step4 : checkStage q4Stages 4 = true := by decide +kernel
theorem q4_step5 : checkStage q4Stages 5 = true := by decide +kernel
theorem q4_step6 : checkStage q4Stages 6 = true := by decide +kernel
theorem q4_step7 : checkStage q4Stages 7 = true := by decide +kernel
theorem q4_steps : checkStages q4Stages = true := by
  apply checkStages_of_stages
  intro i
  fin_cases i
  · exact q4_step0
  · exact q4_step1
  · exact q4_step2
  · exact q4_step3
  · exact q4_step4
  · exact q4_step5
  · exact q4_step6
  · exact q4_step7
def q4Transform (k : Byte) : ℤ := stageVector q4Stages 8 (traceFast k)
theorem q4_hat (hcoeff : CoefficientSpec) (k : Byte) : hat (powerProfile qFast 4) k = q4Transform k := by
  rw [q4Transform, traceFast_eq]
  exact hat_of_transcript hcoeff _ q4Stages q4_initial q4_steps k

end AES8.PaperSharpEntriesPowerTransforms
