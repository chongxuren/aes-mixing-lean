theorem h1_initial_bool : checkInitialBool h1Stages (fun i => powerProfile hFast 1 (byteOf i)) = true := by decide +kernel
theorem h1_initial : checkInitial h1Stages (fun i => powerProfile hFast 1 (byteOf i)) = true := checkInitialBool_sound _ _ h1_initial_bool
theorem h1_step0 : checkStage h1Stages 0 = true := by decide +kernel
theorem h1_step1 : checkStage h1Stages 1 = true := by decide +kernel
theorem h1_step2 : checkStage h1Stages 2 = true := by decide +kernel
theorem h1_step3 : checkStage h1Stages 3 = true := by decide +kernel
theorem h1_step4 : checkStage h1Stages 4 = true := by decide +kernel
theorem h1_step5 : checkStage h1Stages 5 = true := by decide +kernel
theorem h1_step6 : checkStage h1Stages 6 = true := by decide +kernel
theorem h1_step7 : checkStage h1Stages 7 = true := by decide +kernel
theorem h1_steps : checkStages h1Stages = true := by
  apply checkStages_of_stages
  intro i
  fin_cases i
  · exact h1_step0
  · exact h1_step1
  · exact h1_step2
  · exact h1_step3
  · exact h1_step4
  · exact h1_step5
  · exact h1_step6
  · exact h1_step7
def h1Transform (k : Byte) : ℤ := stageVector h1Stages 8 (traceFast k)
theorem h1_hat (hcoeff : CoefficientSpec) (k : Byte) : hat (powerProfile hFast 1) k = h1Transform k := by
  rw [h1Transform, traceFast_eq]
  exact hat_of_transcript hcoeff _ h1Stages h1_initial h1_steps k

