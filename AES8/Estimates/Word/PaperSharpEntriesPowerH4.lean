def h4Stages : StageTables := fun s => match s.val with
  | 0 => h4Stage0
  | 1 => h4Stage1
  | 2 => h4Stage2
  | 3 => h4Stage3
  | 4 => h4Stage4
  | 5 => h4Stage5
  | 6 => h4Stage6
  | 7 => h4Stage7
  | _ => h4Stage8

#eval (do IO.println "starting h4"; (← IO.getStdout).flush : IO Unit)
theorem h4_initial_bool : checkInitialBool h4Stages (fun i => powerProfile hFast 4 (byteOf i)) = true := by decide +kernel
theorem h4_initial : checkInitial h4Stages (fun i => powerProfile hFast 4 (byteOf i)) = true := checkInitialBool_sound _ _ h4_initial_bool
theorem h4_step0 : checkStage h4Stages 0 = true := by decide +kernel
theorem h4_step1 : checkStage h4Stages 1 = true := by decide +kernel
theorem h4_step2 : checkStage h4Stages 2 = true := by decide +kernel
theorem h4_step3 : checkStage h4Stages 3 = true := by decide +kernel
theorem h4_step4 : checkStage h4Stages 4 = true := by decide +kernel
theorem h4_step5 : checkStage h4Stages 5 = true := by decide +kernel
theorem h4_step6 : checkStage h4Stages 6 = true := by decide +kernel
theorem h4_step7 : checkStage h4Stages 7 = true := by decide +kernel
theorem h4_steps : checkStages h4Stages = true := by
  apply checkStages_of_stages
  intro i
  fin_cases i
  · exact h4_step0
  · exact h4_step1
  · exact h4_step2
  · exact h4_step3
  · exact h4_step4
  · exact h4_step5
  · exact h4_step6
  · exact h4_step7
def h4Transform (k : Byte) : ℤ := stageVector h4Stages 8 (traceFast k)
theorem h4_hat (hcoeff : CoefficientSpec) (k : Byte) : hat (powerProfile hFast 4) k = h4Transform k := by
  rw [h4Transform, traceFast_eq]
  exact hat_of_transcript hcoeff _ h4Stages h4_initial h4_steps k

end AES8.PaperSharpEntriesPowerTransforms
