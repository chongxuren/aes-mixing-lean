def q2Stages : StageTables := fun s => match s.val with
  | 0 => q2Stage0
  | 1 => q2Stage1
  | 2 => q2Stage2
  | 3 => q2Stage3
  | 4 => q2Stage4
  | 5 => q2Stage5
  | 6 => q2Stage6
  | 7 => q2Stage7
  | _ => q2Stage8

#eval (do IO.println "starting q2"; (← IO.getStdout).flush : IO Unit)
theorem q2_initial_bool : checkInitialBool q2Stages (fun i => powerProfile qFast 2 (byteOf i)) = true := by decide +kernel
theorem q2_initial : checkInitial q2Stages (fun i => powerProfile qFast 2 (byteOf i)) = true := checkInitialBool_sound _ _ q2_initial_bool
theorem q2_step0 : checkStage q2Stages 0 = true := by decide +kernel
theorem q2_step1 : checkStage q2Stages 1 = true := by decide +kernel
theorem q2_step2 : checkStage q2Stages 2 = true := by decide +kernel
theorem q2_step3 : checkStage q2Stages 3 = true := by decide +kernel
theorem q2_step4 : checkStage q2Stages 4 = true := by decide +kernel
theorem q2_step5 : checkStage q2Stages 5 = true := by decide +kernel
theorem q2_step6 : checkStage q2Stages 6 = true := by decide +kernel
theorem q2_step7 : checkStage q2Stages 7 = true := by decide +kernel
theorem q2_steps : checkStages q2Stages = true := by
  apply checkStages_of_stages
  intro i
  fin_cases i
  · exact q2_step0
  · exact q2_step1
  · exact q2_step2
  · exact q2_step3
  · exact q2_step4
  · exact q2_step5
  · exact q2_step6
  · exact q2_step7
def q2Transform (k : Byte) : ℤ := stageVector q2Stages 8 (traceFast k)
theorem q2_hat (hcoeff : CoefficientSpec) (k : Byte) : hat (powerProfile qFast 2) k = q2Transform k := by
  rw [q2Transform, traceFast_eq]
  exact hat_of_transcript hcoeff _ q2Stages q2_initial q2_steps k

end AES8.PaperSharpEntriesPowerTransforms
