def q3Stages : StageTables := fun s => match s.val with
  | 0 => q3Stage0
  | 1 => q3Stage1
  | 2 => q3Stage2
  | 3 => q3Stage3
  | 4 => q3Stage4
  | 5 => q3Stage5
  | 6 => q3Stage6
  | 7 => q3Stage7
  | _ => q3Stage8

#eval (do IO.println "starting q3"; (← IO.getStdout).flush : IO Unit)
theorem q3_initial_bool : checkInitialBool q3Stages (fun i => powerProfile qFast 3 (byteOf i)) = true := by decide +kernel
theorem q3_initial : checkInitial q3Stages (fun i => powerProfile qFast 3 (byteOf i)) = true := checkInitialBool_sound _ _ q3_initial_bool
theorem q3_step0 : checkStage q3Stages 0 = true := by decide +kernel
theorem q3_step1 : checkStage q3Stages 1 = true := by decide +kernel
theorem q3_step2 : checkStage q3Stages 2 = true := by decide +kernel
theorem q3_step3 : checkStage q3Stages 3 = true := by decide +kernel
theorem q3_step4 : checkStage q3Stages 4 = true := by decide +kernel
theorem q3_step5 : checkStage q3Stages 5 = true := by decide +kernel
theorem q3_step6 : checkStage q3Stages 6 = true := by decide +kernel
theorem q3_step7 : checkStage q3Stages 7 = true := by decide +kernel
theorem q3_steps : checkStages q3Stages = true := by
  apply checkStages_of_stages
  intro i
  fin_cases i
  · exact q3_step0
  · exact q3_step1
  · exact q3_step2
  · exact q3_step3
  · exact q3_step4
  · exact q3_step5
  · exact q3_step6
  · exact q3_step7
def q3Transform (k : Byte) : ℤ := stageVector q3Stages 8 (traceFast k)
theorem q3_hat (hcoeff : CoefficientSpec) (k : Byte) : hat (powerProfile qFast 3) k = q3Transform k := by
  rw [q3Transform, traceFast_eq]
  exact hat_of_transcript hcoeff _ q3Stages q3_initial q3_steps k

end AES8.PaperSharpEntriesPowerTransforms
