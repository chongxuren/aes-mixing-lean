set_option Elab.async false
set_option maxRecDepth 65536
set_option maxHeartbeats 80000000
noncomputable def packedVector (word width offset : ℕ) (i : Index) : ℤ := ((word / 2^(width*i.val) % 2^width : ℕ) : ℤ) - (offset : ℤ)
noncomputable def q1Lookup : Vector := packedVector  8 16
theorem q1_lookup_spec (i : Index) : q1Lookup i = stageVector q1Stages 8 i := by revert i; decide +kernel
noncomputable def q1Fast (k : Byte) : ℤ := q1Lookup (traceFast k)
theorem q1_fast_spec (k : Byte) : q1Fast k = q1Transform k := q1_lookup_spec _
theorem q1_fast_hat (hcoeff : CoefficientSpec) (k : Byte) : AES8.PaperSharpEntriesConvolution.hat (powerProfile qFast 1) k = q1Fast k := by rw [q1_fast_spec]; exact q1_hat hcoeff k
