def q1Stages : StageTables := fun s => match s.val with
  | 0 => q1Stage0
  | 1 => q1Stage1
  | 2 => q1Stage2
  | 3 => q1Stage3
  | 4 => q1Stage4
  | 5 => q1Stage5
  | 6 => q1Stage6
  | 7 => q1Stage7
  | _ => q1Stage8

#eval (do IO.println "starting q1"; (← IO.getStdout).flush : IO Unit)
theorem q1_initial_bool : checkInitialBool q1Stages (fun i => powerProfile qFast 1 (byteOf i)) = true := by decide +kernel
theorem q1_initial : checkInitial q1Stages (fun i => powerProfile qFast 1 (byteOf i)) = true := checkInitialBool_sound _ _ q1_initial_bool
theorem q1_step0 : checkStage q1Stages 0 = true := by decide +kernel
theorem q1_step1 : checkStage q1Stages 1 = true := by decide +kernel
theorem q1_step2 : checkStage q1Stages 2 = true := by decide +kernel
theorem q1_step3 : checkStage q1Stages 3 = true := by decide +kernel
theorem q1_step4 : checkStage q1Stages 4 = true := by decide +kernel
theorem q1_step5 : checkStage q1Stages 5 = true := by decide +kernel
theorem q1_step6 : checkStage q1Stages 6 = true := by decide +kernel
theorem q1_step7 : checkStage q1Stages 7 = true := by decide +kernel
theorem q1_steps : checkStages q1Stages = true := by
  apply checkStages_of_stages
  intro i
  fin_cases i
  · exact q1_step0
  · exact q1_step1
  · exact q1_step2
  · exact q1_step3
  · exact q1_step4
  · exact q1_step5
  · exact q1_step6
  · exact q1_step7
def q1Transform (k : Byte) : ℤ := stageVector q1Stages 8 (traceFast k)
theorem q1_hat (hcoeff : CoefficientSpec) (k : Byte) : hat (powerProfile qFast 1) k = q1Transform k := by
  rw [q1Transform, traceFast_eq]
  exact hat_of_transcript hcoeff _ q1Stages q1_initial q1_steps k

end AES8.PaperSharpEntriesPowerTransforms
