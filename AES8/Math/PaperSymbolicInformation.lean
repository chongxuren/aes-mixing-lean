theorem informationSets_surjective : Function.Surjective informationSets := by decide

theorem informationRows_eq (k : Fin 70) (i : Fin 4) :
    (informationSets k).val.orderEmbOfFin (informationSets k).property i = informationRows k i := by
  have hm : ∀ k i, informationRows k i ∈ (informationSets k).val := by decide
  have hs : ∀ k, StrictMono (informationRows k) := by decide
  exact congrFun (Finset.orderEmbOfFin_unique (informationSets k).property (hm k) (hs k)).symm i

theorem infoMatrix_rows {R : Type*} [CommRing R] (t : R) (k : Fin 70) :
    infoMatrix t (informationSets k) = fun i j => graphMatrix t (informationRows k i) j := by
  funext i j
  exact congrArg (fun q => graphMatrix t q j) (informationRows_eq k i)

