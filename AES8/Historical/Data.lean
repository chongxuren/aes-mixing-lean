/- `norm_num` has short-vector lookup rules, but does not expose every numeral
   lookup of this fourteen-vector.  Reduce its index through the natural value;
   `fin_cases` proves the reduction once, without any arithmetic assumption. -/
theorem vec14_apply {α : Type*}
    (a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 : α) (i : Fin 14) :
    (![a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13] : Fin 14 → α) i =
      match i.val with
      | 0 => a0
      | 1 => a1
      | 2 => a2
      | 3 => a3
      | 4 => a4
      | 5 => a5
      | 6 => a6
      | 7 => a7
      | 8 => a8
      | 9 => a9
      | 10 => a10
      | 11 => a11
      | 12 => a12
      | _ => a13 := by
  fin_cases i <;> rfl

